# Copy to .env and fill in. Never commit .env.

# ---------- App ----------
APP_NAME=AllNote
APP_PORT=3000
# Public address users open in the browser (https://notes.example.com in production).
PUBLIC_URL=http://localhost:3000
# Long random string, e.g. `openssl rand -hex 32`. Auto-generated into the data volume if empty.
SESSION_SECRET=
SESSION_DAYS=30
# Defaults to true when PUBLIC_URL starts with https://
COOKIE_SECURE=
ALLOW_SIGNUP=true
# Optional allow-list: comma separated emails and/or @domains, e.g. alice@x.com,@mycompany.com
ALLOWED_EMAILS=

# ---------- Google single sign-on ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Add GOOGLE_CALLBACK_URL exactly as an "Authorized redirect URI".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ---------- Auto-update from a private GitHub repository ----------
GITHUB_USERNAME=your-github-username
# Fine-grained personal access token with "Contents: Read-only" on the repository.
GITHUB_TOKEN=
# owner/repository
GITHUB_REPO=your-github-username/allnote
GITHUB_BRANCH=main
# Same value as the "Secret" of the GitHub webhook (Settings > Webhooks), `openssl rand -hex 20`.
GITHUB_WEBHOOK_SECRET=
# Fallback polling in seconds (0 = webhook only).
POLL_INTERVAL=60
WEBHOOK_PORT=9000
