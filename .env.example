# Copy to .env and fill in. Never commit .env.

APP_NAME=AllNote
# Public address users open in the browser, e.g. https://notes.example.com.
# Leave empty to derive it from the request (Host / X-Forwarded-Proto from the tunnel).
PUBLIC_URL=
# Long random string, e.g. `openssl rand -hex 32`. Auto-generated into the data volume if empty.
SESSION_SECRET=
SESSION_DAYS=30
# Defaults to true when PUBLIC_URL starts with https://
COOKIE_SECURE=
# Initial value only; the admin can change it later in Settings > Administration.
ALLOW_SIGNUP=true
# Optional allow-list: comma separated emails and/or @domains, e.g. alice@x.com,@mycompany.com
ALLOWED_EMAILS=

# Google single sign-on is configured by the admin in the app: Settings > Administration.
