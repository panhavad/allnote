{
  "name": "allnote",
  "version": "1.1.0",
  "private": true,
  "description": "Simple web note app inspired by Obsidian and Evernote",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "test:report": "node scripts/test-report.js",
    "build:editor": "node scripts/build-editor.js"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.1.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "tiptap-markdown": "^0.9.0"
  }
}
